# SEC RAG — root .gitignore
# Data is frozen and reproducible from src/ingest/ + prompts/ — never committed.
# See DATA_READINESS_REPORT.md for what's on disk and Progress.md for how it got there.

# ---- Raw / derived data ----
data/*
!data/.gitkeep

# ---- Temporary files ----
.tmp/
tmp/
temp/

# ---- Root-level acquisition/audit logs (local historical artifacts only) ----
# Resolves the Phase 0 Checkup's root-log ambiguity: these are one-time
# data-acquisition/audit run logs (stage*.log, phase1_data_audit.log), not
# the application's runtime logging/ directory (already ignored above).
# They stay on disk but are not committed - GIT_CONVENTIONS.md's general
# stance is that generated/runtime logs are not Git content.
*.log

# ---- Large generated artifacts ----
# Anchored to repo root (leading /) - an unanchored "artifacts/" would also
# match src/artifacts/ (Task 2.10's tracked config-hashing/versioning
# package), which must be committed.
/artifacts/
logs/

*.duckdb
*.duckdb.wal
*.parquet
*.zip
*.idx
*.part
*.lance/

# ---- Models / model caches ----
models/
.cache/
**/.huggingface/
*.onnx
*.safetensors
*.bin

# ---- Secrets ----
.env
.env.local
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- IDE / OS ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- Local tooling state ----
.claude/
phase3_loop_supervisor.ps1
claude_settings_local_phase3.json

# ---- Terraform (Task 4.11 - infra/terraform/ skeleton, never applied) ----
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan

# ---- Results: keep small, public result files; do not ignore the whole directory ----
results/*
!results/.gitkeep
!results/*.csv
!results/*.json
!results/*.md
# Task 2.11 - one small immutable JSON per evaluation run. A directory
# matched by "results/*" blocks git from even looking inside it for a
# nested un-ignore pattern, so the directory itself must be re-included
# before its *.json contents can be (narrow exception, not a blanket
# un-ignore of results/).
!results/eval_runs/
!results/eval_runs/*.json
# Task 3.2 - one small per-candidate result JSON (metrics/build-stats/
# compact per-question diagnostics, no chunk/embedding/index data) per
# chunking-ablation candidate. Same "re-include the directory first"
# mechanism as results/eval_runs/ above.
!results/phase3_2/
!results/phase3_2/*.json
# Task 3.3 - same mechanism, one small per-candidate result JSON per
# embedding-model benchmark candidate.
!results/phase3_3/
!results/phase3_3/*.json
# Task 3.4 - same mechanism, one small sparse-baseline result JSON.
!results/phase3_4/
!results/phase3_4/*.json
# Task 3.5 - same mechanism, one small hybrid-fusion result JSON.
!results/phase3_5/
!results/phase3_5/*.json
# Task 3.6 - same mechanism, one small reranking result JSON.
!results/phase3_6/
!results/phase3_6/*.json
# Task 3.7 - same mechanism, one small CRAG confidence-grading result JSON.
!results/phase3_7/
!results/phase3_7/*.json
# Task 3.8 - same mechanism, one small router-evaluation result JSON.
!results/phase3_8/
!results/phase3_8/*.json
# Task 3.9 - same mechanism, one small metadata-prefiltering result JSON.
!results/phase3_9/
!results/phase3_9/*.json
# Task 3.10 - same mechanism, one small XBRL SQL path result JSON.
!results/phase3_10/
!results/phase3_10/*.json
# Task 3.11 - same mechanism, one small derived-calculations result JSON.
!results/phase3_11/
!results/phase3_11/*.json
# Task 3.12 - same mechanism, one small tree/section-navigation result JSON.
!results/phase3_12/
!results/phase3_12/*.json
