# Copy this file to .env and fill in real values locally. .env is
# git-ignored; .env.example is committed and must never contain real
# credentials or a real contact address.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Storage — blank uses the repo-relative default (<repo>/data)
STORAGE_ROOT=

# Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEVICE=auto

# Generation — OpenRouter is the Phase 1 testing provider only (Task 1.7),
# not a frozen production choice. GENERATION_MODEL is intentionally left
# blank here: no OpenRouter model ID is a tracked project default, since
# the user explicitly intends to change it. Set both locally to run
# scripts/smoke_generation.py or the generation_api-marked live test.
GENERATION_PROVIDER=
GENERATION_MODEL=

# SEC requires a descriptive contact identity in the User-Agent header for
# any request to sec.gov / data.sec.gov. This is not a secret — it's public
# contact info SEC uses to reach you if a script misbehaves — but don't
# commit your real one to a tracked file; keep it in your local .env only.
SEC_USER_AGENT="Your Name your.email@example.com"

# Add provider API-key variable names only if the project currently uses them.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
